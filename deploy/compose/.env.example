# Copy to deploy/compose/.env to override. Every value has a default in docker-compose.yml.
SOAR_PARTITIONS=8
SOAR_LOG_LEVEL=info
# OpenSearch JVM heap (dev). 1g is enough for Step 1; raise for load tests.
OS_HEAP=1g
# Index replicas (Step 2). 0 on a single dev node; set both to 1 for a multi-node/production cluster.
SOAR_OS_STATE_REPLICAS=0
SOAR_OS_TS_REPLICAS=0
