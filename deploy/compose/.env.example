# Copy to deploy/compose/.env to override. Every value has a default in docker-compose.yml.
SOAR_PARTITIONS=8
SOAR_LOG_LEVEL=info
# OpenSearch JVM heap (dev). 1g is enough for Step 1; raise for load tests.
OS_HEAP=1g
# Index replicas (Step 2). 0 on a single dev node; set both to 1 for a multi-node/production cluster.
SOAR_OS_STATE_REPLICAS=0
SOAR_OS_TS_REPLICAS=0

# Step 5: queue and Wazuh.
# JetStream reserves max_bytes against free disk. 2 GiB suits a dev box; production uses 20 GiB (spec 8.2).
SOAR_EVENTS_MAX_BYTES=2147483648
# The token Wazuh's Integrator sends as api_key. Replace before exposing port 8081 to anything:
# openssl rand -hex 32
SOAR_SOURCE_TOKEN_WAZUH_PROD=dev-wazuh-token-change-me
# Address the ingest port (8081) is published on. 127.0.0.1 = this machine only; set this host's LAN
# address (for example 10.10.192.198) so a Wazuh manager can push to http://<address>:8081/ingest/wazuh-prod.
# Plain HTTP: anyone on that network can read the token, so use it on a trusted network only.
# SOAR_INGEST_PUBLISH=127.0.0.1
# Address the API and web UI port (8080) is published on; same idea as SOAR_INGEST_PUBLISH. Over plain
# HTTP on a LAN address, sign in with an API key (Keycloak login needs localhost or HTTPS; see docs/ui.md
# for the SSH tunnel). Lab use only: the key crosses the network unencrypted.
# SOAR_API_PUBLISH=127.0.0.1
# Pull from the Wazuh indexer: set these, then `make seed` and `make up`. Use a read-only indexer user.
# SOAR_WAZUH_INDEXER_URL=https://wazuh-indexer.example:9200
# SOAR_WAZUH_INDEXER_USER=soar_reader
# SOAR_WAZUH_INDEXER_PASSWORD=
# SOAR_WAZUH_INDEXER_INSECURE=true   # development only: skips TLS verification (logs a warning)

# NATS durability profile: nats.conf = fsync on every write (spec default for one node, ~1,100 events/s on an
# ordinary disk) or nats-relaxed.conf = fsync every 200 ms (the 1,000+/s targets). `make nats-relaxed` sets it.
# NATS_CONF=nats-relaxed.conf
# More processor workers help once NATS is no longer the limit (each runs two bulk requests per batch of 256).
# SOAR_PROCESSOR_WORKERS=4

# Steps 7-15. The defaults in docker-compose.yml are PUBLIC development values: replace them before the
# stack holds anything real.
# Secret-encryption master key (32 bytes, base64): openssl rand -base64 32. Keep a copy in a vault.
# SOAR_MASTER_KEY_ID=k1
# SOAR_MASTER_KEY=
# First admin API key for the CLI and scripts (soar_ + 32+ random characters).
# SOAR_BOOTSTRAP_API_KEY=soar_<random>
# S3 object storage keys: the root keys of the "s3" service (RustFS), also used by the roles as
# SOAR_BLOB_ACCESS_KEY / SOAR_BLOB_SECRET_KEY. Changing them after the first start needs the s3-data volume
# recreated (the server keeps its first root keys).
# S3_ACCESS_KEY=soar-s3
# S3_SECRET_KEY=
# Keycloak bootstrap admin (console at http://localhost:8180).
# KEYCLOAK_ADMIN=kcadmin
# KEYCLOAK_ADMIN_PASSWORD=
# Integration egress proxy for the runner (optional in development).
# RUNNER_HTTPS_PROXY=http://proxy.example:3128
# Worker parallelism for the normal priority (critical gets half, bulk a quarter).
# SOAR_WORKER_CONCURRENCY=16

# Step 10: stream sources. Local directories file_object sources may read inside the collector container
# (mount them in docker-compose.yml first); none by default. Syslog sources listen on 5514 (published on
# 127.0.0.1 in development).
# SOAR_INGEST_DIRS=/var/spool/soar/ingest
