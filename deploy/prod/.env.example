# Production settings (deploy/prod/docker-compose.yml). Every value without a default is required.
SOAR_OS_URLS=https://opensearch-1.example:9200,https://opensearch-2.example:9200
SOAR_OS_USER=soar
SOAR_OS_PASSWORD=
SOAR_BLOB_ENDPOINT=https://s3.example
SOAR_BLOB_ACCESS_KEY=
SOAR_BLOB_SECRET_KEY=
# Secret-encryption master key: 32 random bytes, base64 (openssl rand -base64 32). Keep a copy in a
# vault: without it no stored secret can be decrypted. Rotation: see docs/runbooks.md.
SOAR_MASTER_KEY_ID=k1
SOAR_MASTER_KEY=
# SOAR_OLD_MASTER_KEYS=k0:<base64>
SOAR_OIDC_ISSUER=https://sso.example/realms/soar
SOAR_OIDC_ORIGIN=https://sso.example
# Optional first admin API key (soar_ + 32+ random characters); remove after creating real admins.
# SOAR_BOOTSTRAP_API_KEY=
# Integration egress goes through an allowlisting proxy (graph.microsoft.com, login.microsoftonline.com, iris.example, ...).
RUNNER_HTTPS_PROXY=http://egress-proxy.example:3128
# TLS / mTLS (optional; files in deploy/prod/certs, seen by the roles at /etc/soar/certs):
# SOAR_OS_CA_FILE=/etc/soar/certs/opensearch-ca.pem          # private CA of the OpenSearch cluster
# SOAR_OS_CERT_FILE=/etc/soar/certs/soar-client.pem         # client certificate when OpenSearch requires one
# SOAR_OS_KEY_FILE=/etc/soar/certs/soar-client-key.pem
# SOAR_NATS_CA_FILE=/etc/soar/certs/nats-ca.pem             # with tls:// NATS URLs
# SOAR_NATS_CERT_FILE= / SOAR_NATS_KEY_FILE=
# SOAR_TLS_CERT_FILE=/etc/soar/certs/soar.pem               # serve api/ingest/health over HTTPS
# SOAR_TLS_KEY_FILE=/etc/soar/certs/soar-key.pem
# SOAR_TLS_CLIENT_CA_FILE=/etc/soar/certs/clients-ca.pem    # and require client certificates (mTLS)
# Worker -> runner gRPC carries decrypted connection secrets: mTLS (the worker refuses plain text to a remote
# runner unless SOAR_RUNNER_INSECURE=true):
# SOAR_RUNNER_CA_FILE=/etc/soar/certs/runner-ca.pem          # CA of the runner's server certificate
# SOAR_RUNNER_CERT_FILE=/etc/soar/certs/worker-client.pem    # the worker's client certificate
# SOAR_RUNNER_KEY_FILE=/etc/soar/certs/worker-client-key.pem
# SOAR_RUNNER_TLS_CERT_FILE=/etc/soar/certs/runner.pem       # the runner's server certificate (name: runner)
# SOAR_RUNNER_TLS_KEY_FILE=/etc/soar/certs/runner-key.pem
# SOAR_RUNNER_TLS_CLIENT_CA_FILE=/etc/soar/certs/workers-ca.pem   # CA of the workers' client certificates
