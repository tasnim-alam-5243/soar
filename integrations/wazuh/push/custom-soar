#!/bin/sh
# Wazuh Integrator entry point. Install as /var/ossec/integrations/custom-soar (mode 750,
# owner root:wazuh) together with custom-soar.py. Wazuh calls: custom-soar <alert_file> <api_key> <hook_url>
WPYTHON_BIN="framework/python/bin/python3"
SCRIPT_PATH_NAME="$0"
DIR_NAME="$(cd "$(dirname "${SCRIPT_PATH_NAME}")"; pwd -P)"
SCRIPT_NAME="$(basename "${SCRIPT_PATH_NAME}")"
case ${DIR_NAME} in
    */active-response/bin | */wodles*) WAZUH_PATH="$(cd "${DIR_NAME}/../.."; pwd)" ;;
    */bin) WAZUH_PATH="$(cd "${DIR_NAME}/.."; pwd)" ;;
    */integrations) WAZUH_PATH="$(cd "${DIR_NAME}/.."; pwd)" ;;
esac
exec "${WAZUH_PATH}/${WPYTHON_BIN}" "${WAZUH_PATH}/integrations/${SCRIPT_NAME}.py" "$@"
